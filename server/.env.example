ADMIN_PASSWORD=change_this_password

# Client / CORS
DASHBOARD_URL=http://localhost:5173

# MQTT Broker
MQTT_PORT=1883

# RabbitMQ
RABBITMQ_URI=amqp://guest:guest@localhost:5672
